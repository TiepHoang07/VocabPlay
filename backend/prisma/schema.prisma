// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words          UserWord[]
  chainScores    WordChainScore[]
  matchScores    MatchingGameScore[]
}

model UserWord {
  id           Int      @id @default(autoincrement())
  userId       String
  word         String
  meaning      String
  partOfSpeech String?
  example      String?
  phonetic     String?
  addedAt      DateTime @default(now())
  memorized    Boolean  @default(false)

  user      User            @relation(fields: [userId], references: [id])

  @@unique([userId, word])
  @@index([userId])
}

model WordChainScore {
  id           Int      @id @default(autoincrement())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  longestChain Int
  highestScore Int
  playedAt     DateTime @default(now())

  @@index([userId])
}

model MatchingGameScore {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  pairsCount  Int
  timeSeconds Int
  attempts    Int
  completedAt DateTime @default(now())

  @@index([userId])
}
